=#6C8EBF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_08" target="n_cell"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="владелец / зоны" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="n_09" target="n_cell"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="задание" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="n_07" target="n_cell"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="роли" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_10" target="n_13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="настройки" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_13" target="n_12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="резерв" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="n_03" target="n_08"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n_15" value="15 Этикетки&#10;ZPL 58×40 / логирование" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="715" y="635" width="220" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="receipt" name="02 Приход"><mxGraphModel dx="1600" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidt