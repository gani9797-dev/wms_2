<mxfile host="app.diagrams.net" modified="2026-10-28T10:48:05+00:00" agent="wms-audit" version="24.7.7"><diagram id="overview" name="01 Обзор"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="l1" value="1. Вход, сессия, права (общий слой для всех модулей)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#C9D1D9;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1520" height="125" as="geometry"/></mxCell><mxCell id="l2" value="2. Приход" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#C9D1D9;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="165" width="1520" height="125" as="geometry"/></mxCell><mxCell id="l3" value="3. Заказы и отгрузка" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#C9D1D9;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="310" width="1520" height="125" as="geometry"/></mxCell><mxCell id="l4" value="4. Склад, задания, справочники" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#C9D1D9;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="455" width="1520" height="125" as="geometry"/></mxCell><mxCell id="l5" value="5. Сервис и настройки" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#C9D1D9;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="600" width="1520" height="125" as="geometry"/></mxCell><mxCell id="n_browser" value="Браузер\n/ login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="55" width="150" height="55" as="geometry"/></mxCell><mxCell id="n_router" value="router.php\nсессия + права" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="245" y="55" width="170" height="55" as="geometry"/></mxCell><mxCell id="n_auth" value="shared/Auth.php\nлогин/пароль" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="455" y="55" width="170" height="55" as="geometry"/></mxCell><mxCell id="n_emp" value="employees\nwms_roles\nrole_access\nrole_permissions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="665" y="45" width="210" height="75" as="geometry"/></mxCell><mxCell id="n_pg" value="PostgreSQL wms\n116 таблиц" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="915" y="55" width="180" height="55" as="geometry"/></mxCell><mxCell id="n_note1" value="Все WMS-страницы и API проходят через router.php → Auth.php.\nПосле входа сотрудник и его роль перечитываются из БД на каждом запросе." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1130" y="45" width="390" height="75" as="geometry"/></mxCell><mxCell id="n_import" value="in/\nCSV / XLSX" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="200" width="150" height="55" as="geometry"/></mxCell><mxCell id="n_02" value="02 Поступления\n+ TSD Приход" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="245" y="200" width="170" height="55" as="geometry"/></mxCell><mxCell id="n_rec" value="receipts\nreceipt_items\nreceipt_operations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="455" y="190" width="210" height="75" as="geometry"/></mxCell><mxCell id="n_stock" value="StockSync" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="705" y="200" width="150" height="55" as="geometry"/></mxCell><mxCell id="n_prod" value="products\nproduct_stock\nproduct_movements" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="895" y="190" width="220" height="75" as="geometry"/></mxCell><mxCell id="n_note2" value="02 и TSD Приход пишут в одни и те же таблицы.\nДобавление/правка строк — inline, с проверкой qty_fact." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1150" y="190" width="370" height="75" as="geometry"/></mxCell><mxCell id="n_031" value="03.1 Заказы\nclient_orders / items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="345" width="170" height="55" as="geometry"/></mxCell><mxCell id="n_03" value="03 Отгрузки\nshipments / items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="265" y="345" width="170" height="55" as="geometry"/></mxCell><mxCell id="n_tsdship" value="TSD Отбор / Сортировка /\nОтгрузка" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="475" y="345" width="200" height="55" as="geometry"/></mxCell><mxCell id="n_picks" value="tsd_picks\nshipment_history\nreadiness / статусы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="715" y="335" width="220" height="75" as="geometry"/></mxCell><mxCell id="n_journal" value="14 Журнал\nwms_journal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="965" y="345" width="170" height="55" as="geometry"/></mxCell><mxCell id="n_note3" value="03.1 → 03: formFromOrders() копирует состав заказа\nв shipment_orders / shipment_items.\nТСД пишет факт отбора в tsd_picks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1170" y="335" width="350" height="75" as="geometry"/></mxCell><mxCell id="n_05" value="05 Ячейки\nstorage_cells\ncell_content" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="490" width="180" height="55" as="geometry"/></mxCell><mxCell id="n_07" value="07 Задания\ntasks / task_items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="275" y="490" width="170" height="55" as="geometry"/></mxCell><mxCell id="n_08" value="08 Номенклатура\nproducts / barcodes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="485" y="490" width="180" height="55" as="geometry"/></mxCell><mxCell id="n_09" value="09 Контрагенты\ncounterparties / owners" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="705" y="490" width="190" height="55" as="geometry"/></mxCell><mxCell id="n_cell" value="CellPlacement\nподбор зоны и ячейки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="935" y="490" width="180" height="55" as="geometry"/></mxCell><mxCell id="n_note4" value="Владелец товара (products.contractor_id)\nучаствует в подборе зоны через CellPlacement." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1150" y="480" width="370" height="75" as="geometry"/></mxCell><mxCell id="n_10" value="10 Сотрудники\nкарточки / роли" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="55" y="635" width="180" height="55" as="geometry"/></mxCell><mxCell id="n_13" value="13 Настройки\nроли / склад / робот" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="275" y="635" width="180" height="55" as="geometry"/></mxCell><mxCell id="n_12" value="12 Уведомления\nnotifications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="495" y="635" width="180" height="55" as="geometry"/></mxCell><mxCell id="n_static" value="01 / 02.1 / 03.2 / 03.3 /\n04 / 05.1 / 06 / 09.1 /\n10.1 / 10.2 / 11 / 13.2–13.4\nстатические макеты" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=13;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="975" y="625" width="220" height="75" as="geometry"/></mxCell><mxCell id="n_note5" value="13.1 — UI без серверного API; 12 использует API 08.&#10;00 — дашборд-агрегатор.&#10;15 — S/A/PL этикетки, ZPL 58×40 и лог." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1215" y="635" width="330" height="75" as="geometry"/></mxCell><mxCell id="note_legend" value="Как читать: сплошная стрелка — основной поток; пунктир — логическая связь.\nСначала смотрите страницы 02–04 по отдельным процессам, затем страницы 05–06 по БД.\nПолный список таблиц — в table-catalog.json." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="20" y="755" width="720" height="80" as="geometry"/></mxCell><mxCell id="e1" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_browser" target="n_router"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="session" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_router" target="n_auth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_auth" target="n_emp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_emp" target="n_pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="файл" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_import" target="n_02"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="запись" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n_02" target="n_rec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="закрытие"