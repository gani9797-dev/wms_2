        <mxCell id="t1" value="WMS TiMLog ↔ ERP: обмен через API v1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#4C2A9E;" vertex="1" parent="1">
