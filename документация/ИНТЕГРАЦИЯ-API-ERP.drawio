        </mxCell>
        <mxCell id="n2" value="SKU должен существовать в номенклатуре WMS: иначе 400 + details[]. Сначала POST /nomenclature." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E1;strokeColor=#E6B800;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;" vertex="1" parent="1">
