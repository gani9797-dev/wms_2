        <mxCell id="n1" value="external_id — ключ идемпотентности: повтор не создаёт дубль и возвращает результат первой обработки." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E1;strokeColor=#E6B800;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;" vertex="1" parent="1">
