  <diagram id="setup" name="2. Настройка WMS и ERP">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
