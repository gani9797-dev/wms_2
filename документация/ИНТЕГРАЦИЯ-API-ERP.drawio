        <mxCell id="n3" value="Триггер вебхука: смена статуса заказа или отгрузки в WMS (ShipmentService, ТСД-отгрузка)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E1;strokeColor=#E6B800;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1090" y="866" width="500" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="Outbox: PENDING → RETRY → SENT / DEAD. После 3 повторов — DEAD; ручной повтор: 13 → Интеграция и логирование." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E1;strokeColor=#E6B800;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1090" y="1020" width="500" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="Алерты: доля 5xx &gt; 5% за час (при ≥ 20 запросах), очередь DEAD &gt; 0, рост очереди &gt; 20." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF8E1;strokeColor=#E6B800;align=left;verticalAlign=top;fontSize=12;spacingLeft=6;" vertex="1" parent="1">
