# WMS TiMLog — PostgreSQL
# Скопировать в .env и поправить под свой сервер.
WMS_DB_DRIVER=pgsql
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=wms
PG_USER=wms
PG_PASSWORD=secret
# Альтернатива одной строкой:
# DATABASE_URL=postgresql://wms:secret@127.0.0.1:5432/wms

# --- Доступ к ТСД ---
# Токен ТСД (мобильные терминалы). Задайте СВОЙ — значение по умолчанию
# 'tsd-12345' опубликовано в клиентских страницах и не является секретом.
TSD_TOKEN=tsd-12345
# База для выдачи PIN сотрудникам по умолчанию: PIN = <база> + id.
# 1000 — прежнее поведение (предсказуемо!). 0 — не выдавать автоматически:
# PIN назначает администратор в модуле 10 «Сотрудники».
WMS_PIN_BASE=1000
